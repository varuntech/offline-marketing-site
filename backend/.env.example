# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/offline_acquisition
# For production, use connection pooling:
# DATABASE_URL=postgresql://user:pass@host:5432/db?ssl=true&pool_min=2&pool_max=10

# SMTP Email Configuration
# Option 1: SendGrid
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# Option 2: AWS SES
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_user
# SMTP_PASS=your_ses_password

# Option 3: Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_mailgun_user
# SMTP_PASS=your_mailgun_password

# Email Addresses
FROM_EMAIL=hello@yourcompany.com
INTERNAL_EMAIL=team@yourcompany.com

# Admin Configuration
ADMIN_URL=https://admin.yourcompany.com
ADMIN_API_KEY=your_secure_random_api_key_here_min_32_chars

# CRM Integration
# HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key

# Salesforce (alternative)
# SALESFORCE_CLIENT_ID=your_client_id
# SALESFORCE_CLIENT_SECRET=your_client_secret
# SALESFORCE_USERNAME=your_username
# SALESFORCE_PASSWORD=your_password

# Payment Processing (if needed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token

# Security
JWT_SECRET=your_jwt_secret_key_min_64_chars_recommended
SESSION_SECRET=your_session_secret_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FORM_LIMIT_MAX=5

# File Upload (if needed)
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=offline-acquisition-uploads

# Twilio (for SMS features)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Feature Flags
ENABLE_CRM_SYNC=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourcompany.com,https://www.yourcompany.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
